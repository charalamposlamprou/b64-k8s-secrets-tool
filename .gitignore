# Virtualenv (recreate with `make setup`)
.venv/

# Runtime state
.app.pid

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Build / install artifacts (from `pip install -e .`)
*.egg-info/
build/
dist/

# Version stamp written into release tarballs by the release workflow
_version.py

# Tooling caches
.pytest_cache/
.ruff_cache/

# Generated / saved secrets — never commit these
*.yaml
*.yml
.env
*.env
.env.*
sealed-*.yaml

# Local test certs/keys
certs/

# ...but do track CI workflows
!.github/workflows/*.yml

# macOS
.DS_Store

# Editor / tooling
.claude/
.vscode/
